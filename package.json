{
  "name": "grantpath",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "db:test-accounts": "tsx scripts/test-accounts.ts",
    "sources:ingest": "tsx scripts/ingest.ts",
    "jobs:run": "tsx scripts/worker.ts",
    "setup:check": "tsx scripts/check-env.ts",
    "fields:check": "tsx scripts/check-field-matching.ts",
    "email:check": "tsx scripts/check-email.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:test-migrate": "tsx scripts/test-db.ts",
    "operator:grant": "tsx scripts/grant-operator.ts",
    "sources:smoke": "tsx scripts/source-smoke.ts",
    "catalogue:corrections": "tsx scripts/catalogue-corrections.ts",
    "providers:images": "tsx scripts/provider-images.ts",
    "sources:discover": "tsx scripts/discover.ts",
    "release:testsprite-gate": "tsx scripts/verify-testsprite.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.12",
    "@hookform/resolvers": "5.2.2",
    "@neondatabase/serverless": "1.2.0",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "1.5.0",
    "better-auth": "1.7.12",
    "cheerio": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "google-auth-library": "11.3.1",
    "inngest": "4.26.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.9",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "fast-check": "4.10.2",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "type": "module",
  "overrides": {
    "inngest": {
      "zod": "$zod"
    },
    "@opentelemetry/api": "1.9.1"
  }
}
