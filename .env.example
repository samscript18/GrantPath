# PostgreSQL / Neon pooled runtime and unpooled migration endpoints.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/grantpath?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST/grantpath?sslmode=require
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Generate with openssl rand -base64 32. No shared default is supplied.
BETTER_AUTH_SECRET=
# production, development, or test. Test mode is forbidden with NODE_ENV=production.
APP_ENV=development
RESEND_API_KEY=
EMAIL_FROM=
# resend for configured delivery, sink only for isolated development/test.
EMAIL_MODE=sink
# Comma-separated allowed recipient suffixes in isolated tests.
TEST_EMAIL_DOMAINS=example.test
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Exact public origins allowed for auth. Never include wildcards.
TRUSTED_ORIGINS=http://localhost:3000
# Required only for preview branch automation. Set as GitHub secrets, never commit.
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_PARENT_BRANCH_ID=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# TEST_DATABASE_URL must name an isolated database containing test.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/grantpath_test
# Separate browser-test database; avoids contamination by synthetic integration fixtures.
E2E_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/grantpath_e2e_test
TEST_ACCOUNT_PASSWORD=
