# PostgreSQL / Neon pooled runtime and unpooled migration endpoints.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/grantpath?sslmode=verify-full
DIRECT_URL=postgresql://USER:PASSWORD@HOST/grantpath?sslmode=verify-full
# Optional secure Neon WebSocket runtime transport when local port5432 is unavailable.
# Prisma migrations still use DIRECT_URL over PostgreSQL TCP.
DATABASE_TRANSPORT=tcp
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Generate with openssl rand -base64 32. No shared default is supplied.
BETTER_AUTH_SECRET=
# Optional Google OAuth Web application credentials. Supply both or leave both empty.
# Redirect URI: BETTER_AUTH_URL + /api/auth/callback/google (register exact URLs in Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# production, development, or test. Test mode is forbidden with NODE_ENV=production.
APP_ENV=development
BREVO_API_KEY=
EMAIL_FROM=
# brevo for configured delivery; EMAIL_FROM must be a verified Brevo sender.
# sink only for isolated development/test.
EMAIL_MODE=sink
# Comma-separated allowed recipient suffixes in isolated tests.
TEST_EMAIL_DOMAINS=example.test
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Exact public origins allowed for auth. Never include wildcards.
TRUSTED_ORIGINS=http://localhost:3000
# Required only for preview branch automation. Set as GitHub secrets, never commit.
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_PARENT_BRANCH_ID=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# TEST_DATABASE_URL must name an isolated database containing test.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/grantpath_test
# Separate browser-test database; avoids contamination by synthetic integration fixtures.
E2E_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/grantpath_e2e_test
TEST_ACCOUNT_PASSWORD=
# Optional release-tooling access. Never expose these through NEXT_PUBLIC variables.
# Use the TestSprite 3.0 portal / official CLI to observe balance, estimate and App triggers.
TESTSPRITE_API_KEY=
TESTSPRITE_PROJECT_ID=

# Server-only signed Cloudinary image uploads. No unsigned preset is needed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Account exports / email challenges use purpose-separated encryption derived from
# BETTER_AUTH_SECRET. Keep it stable: rotation invalidates pending exports and codes.

# Isolated test deployments only; database name must contain a separate test segment.
ENABLE_CONTROLLED_FIXTURES=0

# Optional local deployment identity; Vercel supplies VERCEL_GIT_COMMIT_SHA.
APP_REVISION=

# Related-subject catalogue matching (Vertex AI, server only).
VERTEX_PROJECT_ID=verith-ai
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash
# Use ADC on Google Cloud/local gcloud, an existing service-account file, or inline JSON.
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_CREDENTIALS_JSON=
